# Porta da API
PORT=3000

# Origens autorizadas a chamar a API (CORS), separadas por vírgula.
# Deve conter a URL do frontend.
CORS_ORIGIN=http://localhost:5173

# Conexão com o PostgreSQL (o mesmo banco do docker compose)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=imobpredict
DB_USER=imobpredict
DB_PASSWORD=troque-esta-senha
